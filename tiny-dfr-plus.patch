+/// Draws bars mirrored around the middle of the button, like a waveform.
+/// With no audio it draws a thin line so the slot doesn't look broken.
+fn render_visualizer(
+    c: &Context,
+    levels: &[u8],
+    height: i32,
+    left: f64,
+    width: u64,
+    y_shift: f64,
+) {
+    const BAR_GAP: f64 = 4.0;
+    const MIN_HALF: f64 = 1.5;
+    let width = width as f64;
+    let mid = y_shift + height as f64 / 2.0;
+    let max_half = height as f64 * 0.38;
+    c.set_source_rgb(0.478, 0.635, 0.969);
+    if levels.is_empty() {
+        c.rectangle(left, mid - MIN_HALF / 2.0, width, MIN_HALF);
+        c.fill().unwrap();
+        return;
+    }
+    let n = levels.len() as f64;
+    let bar_w = ((width - BAR_GAP * (n - 1.0)) / n).max(1.0);
+    for (i, &level) in levels.iter().enumerate() {
+        let half = (level as f64 / 255.0 * max_half).max(MIN_HALF);
+        let x = left + i as f64 * (bar_w + BAR_GAP);
+        c.rectangle(x.round(), (mid - half).round(), bar_w.round(), (half * 2.0).round());
+    }
+    c.fill().unwrap();
+}
+
+/// Paints a takeover frame over the whole bar, scaled up with hard pixel edges.
+///
+/// Writes straight into the (portrait) framebuffer surface: the bar's x axis
+/// runs down the surface rows and its y axis runs right to left, the same
+/// mapping the button drawing gets from its 90 degree rotation.
+fn draw_takeover(frame: &Frame, width: i32, height: i32, surface: &mut ImageSurface) {
+    let mut lut = [0u32; 256];
+    for (p, out) in lut.iter_mut().enumerate() {
+        let r = ((p >> 5) & 7) as u32 * 255 / 7;
+        let g = ((p >> 2) & 7) as u32 * 255 / 7;
+        let b = (p & 3) as u32 * 255 / 3;
+        *out = 0xff00_0000 | (r << 16) | (g << 8) | b;
+    }
+    let (w, h) = (width as usize, height as usize);
+    let stride = surface.stride() as usize;
+    let rows = surface.height() as usize;
+    let cols = (surface.width() as usize).min(h);
+    let fy_of: Vec<usize> = (0..cols).map(|sx| (h - 1 - sx) * frame.height / h).collect();
+    let mut data = surface.data().unwrap();
+    for sy in 0..w.min(rows) {
+        let fx = sy * frame.width / w;
+        let row = &mut data[sy * stride..sy * stride + cols * 4];
+        for sx in 0..cols {
+            let px = lut[frame.pixels[fy_of[sx] * frame.width + fx] as usize];
+            row[sx * 4..sx * 4 + 4].copy_from_slice(&px.to_ne_bytes());
+        }
+    }
+}
