diff --git a/src/peer.rs b/src/peer.rs
new file mode 100644
index 0000000..d11f54a
--- /dev/null
+++ b/src/peer.rs
@@ -0,0 +1,147 @@
+//! Sockets that local programs talk to, with every sender checked.
+//!
+//! The sockets are files in `/run/tiny-dfr` (systemd's RuntimeDirectory, owned
+//! by root), created before tiny-dfr drops privileges, so no other account can
+//! claim their names first. Each one has SO_PASSCRED set, so the kernel
+//! attaches the sender's real uid to every datagram; only the user at the
+//! screen (logind's active user on seat0) or root is listened to, and only
+//! they are sent anything back.
+
+use std::{
+    fs, io, mem,
+    os::{
+        fd::AsRawFd,
+        unix::{fs::PermissionsExt, net::UnixDatagram},
+    },
+    path::Path,
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+
+pub const DIR: &str = "/run/tiny-dfr";
+
+/// Binds `/run/tiny-dfr/<name>`, writable by everyone so any program can
+/// send; whether it is listened to is decided per datagram by `allowed`.
+pub fn bind(name: &str) -> io::Result<UnixDatagram> {
+    let _ = fs::create_dir_all(DIR);
+    let path = Path::new(DIR).join(name);
+    let _ = fs::remove_file(&path);
+    let socket = UnixDatagram::bind(&path)?;
+    fs::set_permissions(&path, fs::Permissions::from_mode(0o666))?;
+    let one: libc::c_int = 1;
+    // SAFETY: plain setsockopt on a socket we own, with a correctly sized int.
+    let r = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PASSCRED,
+            &one as *const libc::c_int as *const libc::c_void,
+            mem::size_of::<libc::c_int>() as libc::socklen_t,
+        )
+    };
+    if r != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    socket.set_nonblocking(true)?;
+    Ok(socket)
+}
+
+/// Who sent a datagram, and where to answer.
+#[derive(Clone, Copy)]
+pub struct Peer {
+    addr: libc::sockaddr_un,
+    len: libc::socklen_t,
+    pub uid: u32,
+}
+
+impl Peer {
+    /// Unbound senders can't be answered.
+    pub fn has_address(&self) -> bool {
+        self.len as usize > mem::size_of::<libc::sa_family_t>()
+    }
+
+    pub fn send(&self, socket: &UnixDatagram, msg: &[u8]) {
+        if !self.has_address() || !allowed(self.uid) {
+            return;
+        }
+        // SAFETY: addr/len came from recvmsg for this socket family.
+        unsafe {
+            libc::sendto(
+                socket.as_raw_fd(),
+                msg.as_ptr() as *const libc::c_void,
+                msg.len(),
+                libc::MSG_DONTWAIT | libc::MSG_NOSIGNAL,
+                &self.addr as *const libc::sockaddr_un as *const libc::sockaddr,
+                self.len,
+            );
+        }
+    }
+}
+
+pub enum Recv {
+    /// A datagram from someone allowed to drive the bar: its length.
+    Ok(usize, Peer),
+    /// Something arrived but is ignored (wrong user, truncated).
+    Ignored,
+    WouldBlock,
+}
+
+/// Receives one datagram and checks its sender.
+pub fn recv(socket: &UnixDatagram, buf: &mut [u8]) -> io::Result<Recv> {
+    // SAFETY: zeroed POD structs, filled in by recvmsg; the control buffer is
+    // u64-aligned and large enough for one SCM_CREDENTIALS message.
+    unsafe {
+        let mut addr: libc::sockaddr_un = mem::zeroed();
+        let mut iov = libc::iovec { iov_base: buf.as_mut_ptr() as *mut libc::c_void, iov_len: buf.len() };
+        let mut control = [0u64; 8];
+        let mut msg: libc::msghdr = mem::zeroed();
+        msg.msg_name = &mut addr as *mut libc::sockaddr_un as *mut libc::c_void;
+        msg.msg_namelen = mem::size_of::<libc::sockaddr_un>() as libc::socklen_t;
+        msg.msg_iov = &mut iov;
+        msg.msg_iovlen = 1;
+        msg.msg_control = control.as_mut_ptr() as *mut libc::c_void;
+        msg.msg_controllen = mem::size_of_val(&control) as _;
+        let n = libc::recvmsg(socket.as_raw_fd(), &mut msg, libc::MSG_DONTWAIT | libc::MSG_CMSG_CLOEXEC);
+        if n < 0 {
+            let e = io::Error::last_os_error();
+            return if e.kind() == io::ErrorKind::WouldBlock { Ok(Recv::WouldBlock) } else { Err(e) };
+        }
+        let mut uid = None;
+        let mut c = libc::CMSG_FIRSTHDR(&msg);
+        while !c.is_null() {
+            if (*c).cmsg_level == libc::SOL_SOCKET && (*c).cmsg_type == libc::SCM_CREDENTIALS {
+                let cred = std::ptr::read_unaligned(libc::CMSG_DATA(c) as *const libc::ucred);
+                uid = Some(cred.uid);
+            }
+            c = libc::CMSG_NXTHDR(&msg, c);
+        }
+        let Some(uid) = uid else { return Ok(Recv::Ignored) };
+        if msg.msg_flags & libc::MSG_TRUNC != 0 || !allowed(uid) {
+            return Ok(Recv::Ignored);
+        }
+        Ok(Recv::Ok(n as usize, Peer { addr, len: msg.msg_namelen, uid }))
+    }
+}
+
+static ACTIVE: Mutex<Option<(Instant, Option<u32>)>> = Mutex::new(None);
+
+/// The user logged in at the screen, from logind.
+fn active_uid() -> Option<u32> {
+    let mut cache = ACTIVE.lock().unwrap();
+    if let Some((at, uid)) = *cache {
+        if at.elapsed() < Duration::from_secs(1) {
+            return uid;
+        }
+    }
+    let uid = fs::read_to_string("/run/systemd/seats/seat0").ok().and_then(|s| {
+        s.lines()
+            .find_map(|l| l.strip_prefix("ACTIVE_UID="))
+            .and_then(|v| v.trim().parse().ok())
+    });
+    *cache = Some((Instant::now(), uid));
+    uid
+}
+
+pub fn allowed(uid: u32) -> bool {
+    uid == 0 || Some(uid) == active_uid()
+}
diff --git a/src/takeover.rs b/src/takeover.rs
new file mode 100644
index 0000000..291808e
--- /dev/null
+++ b/src/takeover.rs
@@ -0,0 +1,148 @@
+//! Lets a local program draw on the whole Touch Bar for a while (a game, say).
+//!
+//! The program sends frames to the unix datagram socket
+//! `/run/tiny-dfr/takeover.sock`:
+//!
+//!   b"TDT1" | width: u16 LE | height: u16 LE | width*height bytes of RGB332
+//!
+//! While frames keep arriving the bar shows them instead of the buttons; when
+//! they stop for `STALE_AFTER` the buttons come back. The sender must have an
+//! address (an autobound abstract socket is fine) to receive input back:
+//!
+//!   b"TDE1" | kind: u8 | code: u16 LE | value: i32 LE
+//!
+//! kind 1 = key (code = evdev key code, value 1 pressed / 0 released), only for
+//! the keys in `FORWARDED_KEYS`, so no other typing is exposed; kind 2 = touch
+//! down and 3 = touch up (value = x position in pixels, 0..width).
+//!
+//! Only the user at the screen (or root) can take over the bar and receive
+//! those keys; frames from anyone else are dropped (see `peer.rs`).
+
+use crate::peer::{self, Peer, Recv};
+use std::{
+    os::{
+        fd::{AsFd, BorrowedFd},
+        unix::net::UnixDatagram,
+    },
+    time::{Duration, Instant},
+};
+
+pub const SOCKET_NAME: &str = "takeover.sock";
+pub const STALE_AFTER: Duration = Duration::from_millis(500);
+const MAGIC: &[u8; 4] = b"TDT1";
+const MAX_W: usize = 2200;
+const MAX_H: usize = 64;
+const MAX_PIXELS: usize = 65536;
+/// Esc, Space, Up, Down.
+pub const FORWARDED_KEYS: [u32; 4] = [1, 57, 103, 108];
+
+pub struct Frame {
+    pub width: usize,
+    pub height: usize,
+    /// RGB332, row-major.
+    pub pixels: Vec<u8>,
+}
+
+pub struct Takeover {
+    socket: Option<UnixDatagram>,
+    frame: Option<Frame>,
+    owner: Option<Peer>,
+    last_rx: Option<Instant>,
+}
+
+impl Takeover {
+    pub fn new() -> Takeover {
+        let socket = peer::bind(SOCKET_NAME);
+        let socket = match socket {
+            Ok(s) => Some(s),
+            Err(e) => {
+                println!("Takeover socket unavailable: {e}");
+                None
+            }
+        };
+        Takeover { socket, frame: None, owner: None, last_rx: None }
+    }
+
+    pub fn fd(&self) -> Option<BorrowedFd<'_>> {
+        self.socket.as_ref().map(|s| s.as_fd())
+    }
+
+    /// Drains pending frames. Returns true when the bar has to be redrawn,
+    /// either for a new frame or because the takeover just ended.
+    pub fn poll(&mut self) -> bool {
+        let Some(socket) = &self.socket else { return false };
+        let mut buf = vec![0u8; 8 + MAX_PIXELS];
+        let mut got = false;
+        loop {
+            match peer::recv(socket, &mut buf) {
+                Ok(Recv::Ok(n, from)) => {
+                    if let Some(frame) = parse(&buf[..n]) {
+                        self.frame = Some(frame);
+                        self.owner = Some(from);
+                        self.last_rx = Some(Instant::now());
+                        got = true;
+                    }
+                }
+                Ok(Recv::Ignored) => {}
+                Ok(Recv::WouldBlock) | Err(_) => break,
+            }
+        }
+        if got {
+            return true;
+        }
+        if self.frame.is_some() && self.is_stale() {
+            self.frame = None;
+            self.owner = None;
+            return true;
+        }
+        false
+    }
+
+    fn is_stale(&self) -> bool {
+        self.last_rx.map_or(true, |t| t.elapsed() > STALE_AFTER)
+    }
+
+    pub fn frame(&self) -> Option<&Frame> {
+        self.frame.as_ref()
+    }
+
+    pub fn active(&self) -> bool {
+        self.frame.is_some()
+    }
+
+    fn send(&self, kind: u8, code: u16, value: i32) {
+        let (Some(socket), Some(owner)) = (&self.socket, &self.owner) else { return };
+        let mut msg = Vec::with_capacity(11);
+        msg.extend_from_slice(b"TDE1");
+        msg.push(kind);
+        msg.extend_from_slice(&code.to_le_bytes());
+        msg.extend_from_slice(&value.to_le_bytes());
+        owner.send(socket, &msg);
+    }
+
+    pub fn key(&self, code: u32, pressed: bool) {
+        if FORWARDED_KEYS.contains(&code) {
+            self.send(1, code as u16, pressed as i32);
+        }
+    }
+
+    pub fn touch(&self, down: bool, x: f64) {
+        self.send(if down { 2 } else { 3 }, 0, x as i32);
+    }
+}
+
+fn parse(msg: &[u8]) -> Option<Frame> {
+    if msg.len() < 8 || &msg[..4] != MAGIC {
+        return None;
+    }
+    let width = u16::from_le_bytes([msg[4], msg[5]]) as usize;
+    let height = u16::from_le_bytes([msg[6], msg[7]]) as usize;
+    if width == 0 || height == 0 || width > MAX_W || height > MAX_H || width * height > MAX_PIXELS {
+        return None;
+    }
+    let pixels = &msg[8..];
+    if pixels.len() != width * height {
+        return None;
+    }
+    Some(Frame { width, height, pixels: pixels.to_vec() })
+}
