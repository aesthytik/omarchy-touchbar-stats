diff --git a/src/takeover.rs b/src/takeover.rs
new file mode 100644
index 0000000..5cdffa8
--- /dev/null
+++ b/src/takeover.rs
@@ -0,0 +1,151 @@
+//! Lets a local program draw on the whole Touch Bar for a while (a game, say).
+//!
+//! The program sends frames to the abstract unix datagram socket
+//! `@tiny-dfr-takeover`:
+//!
+//!   b"TDT1" | width: u16 LE | height: u16 LE | width*height bytes of RGB332
+//!
+//! While frames keep arriving the bar shows them instead of the buttons; when
+//! they stop for `STALE_AFTER` the buttons come back. The sender must have an
+//! address (an autobound abstract socket is fine) to receive input back:
+//!
+//!   b"TDE1" | kind: u8 | code: u16 LE | value: i32 LE
+//!
+//! kind 1 = key (code = evdev key code, value 1 pressed / 0 released), only for
+//! the keys in `FORWARDED_KEYS`, so no other typing is exposed; kind 2 = touch
+//! down and 3 = touch up (value = x position in pixels, 0..width).
+//!
+//! Anyone on the machine can take over the bar, which is visible to the user,
+//! and gets nothing back but those few keys while it does.
+
+use std::{
+    io::ErrorKind,
+    os::{
+        fd::{AsFd, BorrowedFd},
+        linux::net::SocketAddrExt,
+        unix::net::{SocketAddr, UnixDatagram},
+    },
+    time::{Duration, Instant},
+};
+
+pub const SOCKET_NAME: &[u8] = b"tiny-dfr-takeover";
+pub const STALE_AFTER: Duration = Duration::from_millis(500);
+const MAGIC: &[u8; 4] = b"TDT1";
+const MAX_W: usize = 2200;
+const MAX_H: usize = 64;
+const MAX_PIXELS: usize = 65536;
+/// Esc, Space, Up, Down.
+pub const FORWARDED_KEYS: [u32; 4] = [1, 57, 103, 108];
+
+pub struct Frame {
+    pub width: usize,
+    pub height: usize,
+    /// RGB332, row-major.
+    pub pixels: Vec<u8>,
+}
+
+pub struct Takeover {
+    socket: Option<UnixDatagram>,
+    frame: Option<Frame>,
+    owner: Option<SocketAddr>,
+    last_rx: Option<Instant>,
+}
+
+impl Takeover {
+    pub fn new() -> Takeover {
+        let socket = SocketAddr::from_abstract_name(SOCKET_NAME)
+            .and_then(|addr| UnixDatagram::bind_addr(&addr))
+            .and_then(|s| s.set_nonblocking(true).map(|_| s));
+        let socket = match socket {
+            Ok(s) => Some(s),
+            Err(e) => {
+                println!("Takeover socket unavailable: {e}");
+                None
+            }
+        };
+        Takeover { socket, frame: None, owner: None, last_rx: None }
+    }
+
+    pub fn fd(&self) -> Option<BorrowedFd<'_>> {
+        self.socket.as_ref().map(|s| s.as_fd())
+    }
+
+    /// Drains pending frames. Returns true when the bar has to be redrawn,
+    /// either for a new frame or because the takeover just ended.
+    pub fn poll(&mut self) -> bool {
+        let Some(socket) = &self.socket else { return false };
+        let mut buf = vec![0u8; 8 + MAX_PIXELS];
+        let mut got = false;
+        loop {
+            match socket.recv_from(&mut buf) {
+                Ok((n, addr)) => {
+                    if let Some(frame) = parse(&buf[..n]) {
+                        self.frame = Some(frame);
+                        self.owner = if addr.is_unnamed() { None } else { Some(addr) };
+                        self.last_rx = Some(Instant::now());
+                        got = true;
+                    }
+                }
+                Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                Err(_) => break,
+            }
+        }
+        if got {
+            return true;
+        }
+        if self.frame.is_some() && self.is_stale() {
+            self.frame = None;
+            self.owner = None;
+            return true;
+        }
+        false
+    }
+
+    fn is_stale(&self) -> bool {
+        self.last_rx.map_or(true, |t| t.elapsed() > STALE_AFTER)
+    }
+
+    pub fn frame(&self) -> Option<&Frame> {
+        self.frame.as_ref()
+    }
+
+    pub fn active(&self) -> bool {
+        self.frame.is_some()
+    }
+
+    fn send(&self, kind: u8, code: u16, value: i32) {
+        let (Some(socket), Some(owner)) = (&self.socket, &self.owner) else { return };
+        let mut msg = Vec::with_capacity(11);
+        msg.extend_from_slice(b"TDE1");
+        msg.push(kind);
+        msg.extend_from_slice(&code.to_le_bytes());
+        msg.extend_from_slice(&value.to_le_bytes());
+        let _ = socket.send_to_addr(&msg, owner);
+    }
+
+    pub fn key(&self, code: u32, pressed: bool) {
+        if FORWARDED_KEYS.contains(&code) {
+            self.send(1, code as u16, pressed as i32);
+        }
+    }
+
+    pub fn touch(&self, down: bool, x: f64) {
+        self.send(if down { 2 } else { 3 }, 0, x as i32);
+    }
+}
+
+fn parse(msg: &[u8]) -> Option<Frame> {
+    if msg.len() < 8 || &msg[..4] != MAGIC {
+        return None;
+    }
+    let width = u16::from_le_bytes([msg[4], msg[5]]) as usize;
+    let height = u16::from_le_bytes([msg[6], msg[7]]) as usize;
+    if width == 0 || height == 0 || width > MAX_W || height > MAX_H || width * height > MAX_PIXELS {
+        return None;
+    }
+    let pixels = &msg[8..];
+    if pixels.len() != width * height {
+        return None;
+    }
+    Some(Frame { width, height, pixels: pixels.to_vec() })
+}
