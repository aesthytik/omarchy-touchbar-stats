@@ -0,0 +1,89 @@
+//! Receives audio levels for `Visualizer` buttons.
+//!
+//! The user at the screen can send bar heights as a datagram to the unix
+//! socket `/run/tiny-dfr/visualizer.sock`: one byte per bar, 0 (silent) to
+//! 255 (loud), at most `MAX_BARS` bars. Other users are ignored (see `peer.rs`).
+
+use crate::peer::{self, Recv};
+use std::{
+    os::{
+        fd::{AsFd, BorrowedFd},
+        unix::net::UnixDatagram,
+    },
+    time::{Duration, Instant},
+};
+
+pub const SOCKET_NAME: &str = "visualizer.sock";
+pub const MAX_BARS: usize = 256;
+/// After this long without data the bars fall back to silence.
+pub const STALE_AFTER: Duration = Duration::from_millis(500);
+
+pub struct AudioFeed {
+    socket: Option<UnixDatagram>,
+    levels: Vec<u8>,
+    last_rx: Option<Instant>,
+}
+
+impl AudioFeed {
+    pub fn new() -> AudioFeed {
+        let socket = peer::bind(SOCKET_NAME);
+        let socket = match socket {
+            Ok(s) => Some(s),
+            Err(e) => {
+                println!("Visualizer socket unavailable, waveform disabled: {e}");
+                None
+            }
+        };
+        AudioFeed {
+            socket,
+            levels: Vec::new(),
+            last_rx: None,
+        }
+    }
+
+    pub fn fd(&self) -> Option<BorrowedFd<'_>> {
+        self.socket.as_ref().map(|s| s.as_fd())
+    }
+
+    /// Drains pending datagrams. Returns true when the levels to draw changed.
+    pub fn poll(&mut self) -> bool {
+        let Some(socket) = &self.socket else {
+            return false;
+        };
+        let mut buf = [0u8; MAX_BARS];
+        let mut latest: Option<Vec<u8>> = None;
+        loop {
+            match peer::recv(socket, &mut buf) {
+                Ok(Recv::Ok(n, _)) if n > 0 => latest = Some(buf[..n].to_vec()),
+                Ok(Recv::Ok(..)) | Ok(Recv::Ignored) => {}
+                Ok(Recv::WouldBlock) | Err(_) => break,
+            }
+        }
+        if let Some(levels) = latest {
+            self.last_rx = Some(Instant::now());
+            if levels != self.levels {
+                self.levels = levels;
+                return true;
+            }
+            return false;
+        }
+        if self.is_stale() && self.levels.iter().any(|&l| l > 0) {
+            self.levels.iter_mut().for_each(|l| *l = 0);
+            return true;
+        }
+        false
+    }
+
+    fn is_stale(&self) -> bool {
+        self.last_rx.map_or(true, |t| t.elapsed() > STALE_AFTER)
+    }
+
+    /// True while audio is arriving, so the main loop wakes up to notice when it stops.
+    pub fn is_live(&self) -> bool {
+        !self.is_stale() && self.levels.iter().any(|&l| l > 0)
+    }
+
+    pub fn levels(&self) -> &[u8] {
+        &self.levels
+    }
+}
